<!DOCTYPE html>
<html>
<head>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            line-height: 1.6; 
            color: #333333; 
            max-width: 600px; 
            margin: 0 auto; 
            padding: 20px;
            background-color: #ffffff;
        }
        .header { 
            text-align: center; 
            margin-bottom: 25px; 
        }
        .logo { 
            max-width: 90px; 
            height: auto;
        }
        .content {
            margin: 20px 0;
            font-size: 15px;
            line-height: 1.5;
        }
        .checklist-info {
            background-color: #f8f9fa;
            border-left: 4px solid #FFD700;
            padding: 15px;
            margin: 20px 0;
        }
        .checklist-title {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 5px;
        }
        .checklist-doc {
            color: #666666;
            font-size: 14px;
        }
        .footer {
            margin-top: 30px;
            font-size: 14px;
            color: #666666;
            border-top: 1px solid #eeeeee;
            padding-top: 20px;
        }
        .signature {
            margin-top: 5px;
            font-weight: bold;
        }

        @media only screen and (max-width: 600px) {
            body {
                padding: 10px;
            }
        }
    </style>
</head>
<body>

    <div class="header" style="text-align: left;">
        <img src="<%= logoUrl %>" alt="Company Logo" class="logo">
    </div>

    <div class="content">
        <p>Hi <%= firstName %>,</p>
    
        <p>A new checklist has been assigned to you:</p>
        
        <div class="checklist-info">
            <p class="checklist-title"><%= checklistTitle %></p>
            <p class="checklist-doc">Document Number: <%= documentNumber %></p>
        </div>
        
        <p>Please log in to your account to view and complete this checklist.</p>
    
        <p>For any concerns or assistance, kindly send a message to 
           <a href="mailto:dev.team@tolaram.com" style="color: #FFD700;">
               dev.team@tolaram.com
           </a>
        </p>
    </div>

    <div class="footer">
        <p>Cheers,</p>
        <p class="signature">Packaging Check List</p>
        <p>&copy; <span id="year"></span> Tolaram Dev Team. All rights reserved.</p>
    </div>

    <script>
        document.getElementById("year").textContent = new Date().getFullYear();
    </script>
</body>
</html>
