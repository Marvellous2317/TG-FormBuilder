<!DOCTYPE html>
<html>
<head>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            line-height: 1.6; 
            color: #333333; 
            max-width: 600px; 
            margin: 0 auto; 
            padding: 20px;
            background-color: #ffffff;
        }
        .header { 
            text-align: center; 
            margin-bottom: 25px; 
        }
        .logo { 
            max-width: 90px; 
            height: auto;
        }
        .content {
            margin: 20px 0;
            font-size: 15px;
            line-height: 1.5;
        }
        .button {
            display: inline-block;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
            margin: 20px 0;
            width: 50%;
            height: 50%;
            background-color: #000000;
            color: #FFD700 !important; 
            text-align: center;
        }
        .footer {
            margin-top: 30px;
            font-size: 14px;
            color: #666666;
            border-top: 1px solid #eeeeee;
            padding-top: 20px;
        }
        .signature {
            margin-top: 5px;
            font-weight: bold;
        }

        @media only screen and (max-width: 600px) {
            body {
                padding: 10px;
            }

            .button {
                width: 100%;
                text-align: center;
                padding: 15px;
                box-sizing: border-box;
            }
        }
    </style>
</head>
<body>

    <div class="header" style="text-align: left;">
        <img src="<%= logoUrl %>" alt="Company Logo" class="logo">
    </div>

    <div class="content">
        <p>Hi <%= firstName %>,</p>
    
        <p>This is to inform you that your account has been  approved</p>
    
   
    
        <p>For any concerns or assistance, kindly send a message to 
           <a href="mailto:dev.team@tolaram.com"  style="color: #FFD700;">
               dev.team@tolaram.com
               
           </a>
        </p>
    </div>

    <div class="footer">
        <p>Cheers,</p>
        <p class="signature">Packaging Check List</p>
        <p>&copy; <span id="year"></span> Tolaram Dev Team. All rights reserved.</p>
    </div>

    <script>
        document.getElementById("year").textContent = new Date().getFullYear();
    </script>
</body>
</html>
